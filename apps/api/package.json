{
  "name": "@walletwise/api",
  "version": "0.0.0",
  "private": true,
  "description": "WalletWise API server (NestJS + Fastify)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --watch --watch-preserve-output -r @swc-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@prisma/client": "^5.20.0",
    "@walletwise/ai": "workspace:*",
    "@walletwise/config": "workspace:*",
    "@walletwise/contracts": "workspace:*",
    "@walletwise/db": "workspace:*",
    "ai": "^6.0.49",
    "@ai-sdk/groq": "^3.0.15",
    "@ai-sdk/openai-compatible": "^2.0.13",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "bullmq": "^5.21.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertokens-node": "^20.1.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.2"
  }
}
