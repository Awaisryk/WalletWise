# WalletWise local dev environment — copy to .env.dev and fill in secrets.
# This file is committed. .env.dev is gitignored.

# Postgres (app DB)
POSTGRES_DB=walletwise
POSTGRES_USER=walletwise
POSTGRES_PASSWORD=walletwise
POSTGRES_HOST_PORT=5432

# SuperTokens DB (separate Postgres instance)
ST_POSTGRES_DB=supertokens
ST_POSTGRES_USER=supertokens
ST_POSTGRES_PASSWORD=supertokens

# SuperTokens core
SUPERTOKENS_API_KEY=dev-key-1234567890-abcdef1234
SUPERTOKENS_HOST_PORT=3567
SUPERTOKENS_CORE_URL=http://supertokens:3567

# App DB connection (used by api, worker, migrate)
DATABASE_URL=postgresql://walletwise:walletwise@postgres:5432/walletwise?schema=public

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST_PORT=6379

# API
API_HOST_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# AI
AI_ENV=dev
LOCAL_AI_BASE_URL=
GROQ_API_KEY=

# Worker
WORKER_CONCURRENCY=5
