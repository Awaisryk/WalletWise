# WalletWise local dev env template — copy to .env.dev and fill GROQ_API_KEY.
# This file is committed; .env.dev is gitignored.
#
# `pnpm dev` and the db:* scripts load .env.dev via dotenv, and docker compose
# loads it via --env-file. Connection strings are HOST-reachable (localhost) for
# host-run apps; the compose services override them with container hostnames in
# their own `environment:` blocks, so the same file works both ways.
#
# Ports below are the defaults. If 5432 / 6379 / 3567 are already taken on your
# machine, bump the *_HOST_PORT values and the matching localhost ports below.

NODE_ENV=development

# Postgres (app DB)
POSTGRES_DB=walletwise
POSTGRES_USER=walletwise
POSTGRES_PASSWORD=walletwise
POSTGRES_HOST_PORT=5432

# SuperTokens auth DB
ST_POSTGRES_DB=supertokens
ST_POSTGRES_USER=supertokens
ST_POSTGRES_PASSWORD=supertokens

# SuperTokens core
SUPERTOKENS_API_KEY=dev-key-change-me-0123456789abcdef
SUPERTOKENS_HOST_PORT=3567

# Redis
REDIS_HOST_PORT=6379

# Host-reachable connection strings (used by host-run apps via dotenv)
DATABASE_URL=postgresql://walletwise:walletwise@localhost:5432/walletwise?schema=public
REDIS_URL=redis://localhost:6379
SUPERTOKENS_CORE_URL=http://localhost:3567

# API / web
PORT=4000
API_HOST_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# AI — set GROQ_API_KEY for the prod path (Groq gpt-oss-120b); or set AI_ENV=dev
# with a local OpenAI-compatible gpt-oss endpoint in LOCAL_AI_BASE_URL.
AI_ENV=prod
LOCAL_AI_BASE_URL=
GROQ_API_KEY=

# Worker
WORKER_CONCURRENCY=5
